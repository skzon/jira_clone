<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Jira Clone" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Jira Clone">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
      defer></script>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg jira-navbar">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand" do %>
          <span class="brand-mark">J</span>
          <span><%= t("nav.brand") %></span>
        <% end %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainNav" aria-controls="mainNav"
                aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
          <% if user_signed_in? %>
            <ul class="navbar-nav me-auto">
              <li class="nav-item">
                <%= link_to t("nav.dashboard"), root_path,
                    class: "nav-link #{'active' if current_page?(root_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to t("nav.projects"), projects_path,
                    class: "nav-link #{'active' if controller_name == 'projects'}" %>
              </li>
            </ul>

            <%# Search bar — shown only to signed-in users %>
            <% if user_signed_in? %>
              <%= form_with url: search_path, method: :get, local: true,
                    class: "d-flex me-2" do |f| %>
                <div class="input-group input-group-sm">
                  <%= f.search_field :q,
                        class: "form-control",
                        placeholder: t("search.placeholder"),
                        style: "width:220px;background:#f4f5f7;border-color:#dfe1e6;" %>
                  <button class="btn btn-outline-secondary btn-sm" type="submit">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              <% end %>
            <% end %>
          <% end %>

          <div class="d-flex align-items-center gap-2 ms-auto">
            <%# Locale switcher — shows all locales; active one is highlighted %>
            <div class="btn-group btn-group-sm me-2" role="group" aria-label="Language">
              <% I18n.available_locales.each do |loc| %>
                <% active = loc == I18n.locale %>
                <%= link_to t("locale.#{loc}"),
                      active ? "#" : switch_locale_path(locale: loc),
                      class: "btn #{ active ? 'btn-primary' : 'btn-outline-secondary' }",
                      "aria-current": (active ? "true" : nil) %>
              <% end %>
            </div>

            <% if user_signed_in? %>
              <span class="user-chip">
                <span class="avatar"><%= current_user.email.first %></span>
                <span><%= current_user.email %></span>
              </span>

              <%= button_to destroy_user_session_path,
                  method: :delete,
                  form: { class: "d-inline" },
                  class: "btn btn-subtle btn-sm" do %>
                <i class="bi bi-box-arrow-right me-1"></i> <%= t("nav.logout") %>
              <% end %>
            <% else %>
              <%= link_to t("nav.log_in"), new_user_session_path,
                  class: "btn btn-subtle btn-sm" %>
              <%= link_to t("nav.sign_up"), new_user_registration_path,
                  class: "btn btn-primary btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="container app-shell">
      <% if flash.any? %>
        <div class="flash-stack mb-3">
          <% flash.each do |type, message| %>
            <div class="alert alert-<%= type %> alert-dismissible fade show" role="alert">
              <%= message %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
