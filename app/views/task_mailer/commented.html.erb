<p style="margin:0 0 12px;font-size:16px;font-weight:600;">
  New comment on a task
</p>
<p style="margin:0 0 16px;color:#42526e;">
  <%= @author.email %> commented on
  <strong><%= @task.title %></strong> in <strong><%= @task.project.name %></strong>.
</p>

<table cellpadding="0" cellspacing="0" style="width:100%;background:#ffffff;border:1px solid #dfe1e6;border-left:4px solid #0052cc;border-radius:6px;padding:14px 16px;margin-bottom:20px;">
  <tr>
    <td>
      <div style="font-size:12px;color:#6b778c;margin-bottom:6px;">
        <%= @author.email %> · <%= @comment.created_at.strftime("%b %-d, %Y at %H:%M") %>
      </div>
      <div style="font-size:14px;color:#172b4d;white-space:pre-line;">
        <%= @comment.body %>
      </div>
    </td>
  </tr>
</table>

<p style="margin:0;">
  <a href="<%= @task_url %>#comment-<%= @comment.id %>"
     style="display:inline-block;background:#0052cc;color:#fff;text-decoration:none;padding:10px 18px;border-radius:4px;font-weight:600;">
    Reply on Jira Clone
  </a>
</p>
