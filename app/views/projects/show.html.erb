<% content_for :title, "#{@project.name} · Jira Clone" %>

<div class="page-header">
  <div class="d-flex align-items-center gap-3">
    <span class="project-key" style="width:48px;height:48px;font-size:1.05rem;">
      <%= @project.name.to_s.first(2).upcase %>
    </span>
    <div>
      <div class="breadcrumb">
        <%= link_to "Projects", projects_path %> /
        <span><%= @project.name %></span>
      </div>
      <h1 class="mb-1"><%= @project.name %></h1>
      <div class="d-flex align-items-center gap-2 text-muted small">
        <%= status_badge(@project.status) %>
        <span>· Created by <strong><%= @project.creator&.email || "unknown" %></strong></span>
        <span>· <%= time_ago_in_words(@project.created_at) %> ago</span>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= link_to new_project_task_path(@project), class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i> New task
    <% end %>
    <%= link_to edit_project_path(@project), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil me-1"></i> Edit
    <% end %>
    <%= button_to project_path(@project),
          method: :delete,
          form: { class: "d-inline", data: { turbo_confirm: "Delete this project? All its tasks, comments and attachments will be removed for everyone." } },
          class: "btn btn-outline-danger" do %>
      <i class="bi bi-trash me-1"></i> Delete
    <% end %>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card p-4 mb-3">
      <h2 class="h6 section-title">Description</h2>
      <% if @project.description.present? %>
        <p class="mb-0" style="white-space: pre-line;"><%= @project.description %></p>
      <% else %>
        <p class="text-muted mb-0">No description provided.</p>
      <% end %>
    </div>

    <div class="card p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 section-title mb-0">
          Tasks
          <span class="text-muted ms-1">(<%= @tasks.size %>)</span>
        </h2>
        <%= link_to new_project_task_path(@project), class: "btn btn-sm btn-primary" do %>
          <i class="bi bi-plus-lg me-1"></i> New task
        <% end %>
      </div>

      <% if @tasks.any? %>
        <div class="list-group list-group-flush">
          <% @tasks.each do |task| %>
            <%# Cache each task row — expires when task is updated %>
            <% cache ["task-row/v1", task, I18n.locale] do %>
            <%= link_to task_path(task),
                  class: "list-group-item list-group-item-action d-flex align-items-center gap-3 px-0 py-3 border-0 border-bottom" do %>
              <%= status_badge(task.status) %>
              <div class="flex-grow-1">
                <div class="fw-semibold text-dark"><%= task.title %></div>
                <div class="text-muted small">
                  #<%= task.id %>
                  <% if task.description.present? %>
                    · <%= truncate(task.description, length: 90) %>
                  <% end %>
                </div>
              </div>
              <div class="text-end small text-muted">
                <% if task.assignee %>
                  <span class="user-chip" style="background:#fff;border-color:#dfe1e6;">
                    <span class="avatar"><%= task.assignee.email.first %></span>
                    <span><%= task.assignee.display_name %></span>
                  </span>
                <% else %>
                  <span class="jira-badge is-todo">Unassigned</span>
                <% end %>
              </div>
            <% end %>
            <% end %> <%# end cache %>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state" style="padding:2rem 1rem;">
          <div class="empty-icon"><i class="bi bi-clipboard-check"></i></div>
          <h3>No tasks yet</h3>
          <p>Break the work down into tasks and assign them to your team.</p>
          <%= link_to new_project_task_path(@project), class: "btn btn-primary" do %>
            <i class="bi bi-plus-lg me-1"></i> Create the first task
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-4">
    <%= render "project_members/panel",
          project: @project,
          members: @members,
          candidate_members: @candidate_members %>

    <div class="card p-4 mb-3">
      <h2 class="h6 section-title">Details</h2>
      <dl class="row mb-0 small">
        <dt class="col-5 text-muted fw-normal">Status</dt>
        <dd class="col-7 mb-2"><%= status_badge(@project.status) %></dd>

        <dt class="col-5 text-muted fw-normal">Creator</dt>
        <dd class="col-7 mb-2"><%= @project.creator&.email || "—" %></dd>

        <dt class="col-5 text-muted fw-normal">Total tasks</dt>
        <dd class="col-7 mb-2"><%= @tasks.size %></dd>

        <dt class="col-5 text-muted fw-normal">Open</dt>
        <dd class="col-7 mb-2"><%= @tasks.count { |t| t.status != "done" } %></dd>

        <dt class="col-5 text-muted fw-normal">Done</dt>
        <dd class="col-7 mb-0"><%= @tasks.count { |t| t.status == "done" } %></dd>
      </dl>
    </div>

    <%= link_to "Back to all projects", projects_path, class: "btn btn-subtle btn-sm" %>
  </div>
</div>
