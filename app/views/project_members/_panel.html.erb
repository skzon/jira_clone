<div class="card p-4 mb-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h6 section-title mb-0">
      Members
      <span class="text-muted ms-1">(<%= members.size %>)</span>
    </h2>
  </div>

  <ul class="list-unstyled mb-3 d-flex flex-column gap-2">
    <% members.each do |member| %>
      <% membership = project.project_members.find { |pm| pm.user_id == member.id } %>
      <li class="d-flex align-items-center gap-2">
        <span class="avatar" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#4c9aff,#5243aa);color:#fff;font-weight:700;font-size:0.75rem;text-transform:uppercase;">
          <%= member.email.first %>
        </span>
        <div class="flex-grow-1 small">
          <div class="fw-semibold text-dark"><%= member.email %></div>
          <% if member.id == project.user_id %>
            <span class="text-muted" style="font-size:0.75rem;">Creator</span>
          <% end %>
        </div>
        <% if membership %>
          <%= button_to project_project_member_path(project, membership),
                method: :delete,
                form: { class: "d-inline", data: { turbo_confirm: "Remove #{member.email} from this project?" } },
                class: "btn btn-sm btn-subtle text-muted p-1",
                title: "Remove member" do %>
            <i class="bi bi-x-lg"></i>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if candidate_members.any? %>
    <%= form_with url: project_project_members_path(project), method: :post, local: true, class: "d-flex gap-2" do |f| %>
      <%= select_tag :user_id,
            options_for_select([["Pick a user…", ""]] + candidate_members.pluck(:email, :id)),
            class: "form-select form-select-sm",
            required: true %>
      <%= f.submit "Add", class: "btn btn-primary btn-sm" %>
    <% end %>
  <% else %>
    <p class="text-muted small mb-0">
      All users are already members.
      <%= link_to "Invite a new teammate", new_user_registration_path %>.
    </p>
  <% end %>
</div>
