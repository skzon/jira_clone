<% content_for :title, "#{@task.title} · #{@task.project.name}" %>

<div class="page-header">
  <div>
    <div class="breadcrumb">
      <%= link_to "Projects", projects_path %> /
      <%= link_to @task.project.name, project_path(@task.project) %> /
      <span>Task #<%= @task.id %></span>
    </div>
    <h1 class="mb-1"><%= @task.title %></h1>
    <div class="d-flex align-items-center gap-2 text-muted small">
      <%= status_badge(@task.status) %>
      <span>· Reported by <strong><%= @task.reporter&.email || "unknown" %></strong></span>
      <span>· Created <%= time_ago_in_words(@task.created_at) %> ago</span>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to edit_task_path(@task), class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil me-1"></i> Edit
    <% end %>
    <%= button_to task_path(@task),
          method: :delete,
          form: { class: "d-inline", data: { turbo_confirm: "Delete this task? This can't be undone." } },
          class: "btn btn-outline-danger" do %>
      <i class="bi bi-trash me-1"></i> Delete
    <% end %>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card p-4 mb-3">
      <h2 class="h6 section-title">Description</h2>
      <% if @task.description.present? %>
        <p class="mb-0" style="white-space: pre-line;"><%= @task.description %></p>
      <% else %>
        <p class="text-muted mb-0">No description provided.</p>
      <% end %>
    </div>

    <div class="card p-4 mb-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 section-title mb-0">Attachments</h2>
        <span class="text-muted small">
          <%= pluralize(@task.attachments.size, "file") %>
        </span>
      </div>

      <% if @task.attachments.any? %>
        <ul class="list-group list-group-flush">
          <% @task.attachments.each do |attachment| %>
            <li class="list-group-item d-flex align-items-center px-0 py-2">
              <i class="bi bi-paperclip me-2 text-muted"></i>
              <%= link_to attachment.filename.to_s,
                    rails_blob_path(attachment, disposition: "attachment"),
                    class: "text-decoration-none flex-grow-1" %>
              <span class="text-muted small me-3">
                <%= number_to_human_size(attachment.byte_size) %>
              </span>
              <%= button_to task_attachment_path(@task, attachment.id),
                    method: :delete,
                    form: { class: "d-inline", data: { turbo_confirm: "Remove this attachment?" } },
                    class: "btn btn-sm btn-subtle text-danger",
                    title: "Remove" do %>
                <i class="bi bi-x-lg"></i>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted small mb-3">No attachments yet.</p>
      <% end %>

      <%= form_with url: task_path(@task),
            method: :patch,
            multipart: true,
            local: true,
            class: "mt-3 d-flex gap-2 align-items-center" do |f| %>
        <%= f.file_field "task[attachments][]",
              multiple: true,
              class: "form-control form-control-sm",
              required: true %>
        <%= f.submit "Upload", class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>

    <div class="card p-4">
      <h2 class="h6 section-title">
        Comments
        <span class="text-muted ms-1">(<%= @task.comments.size %>)</span>
      </h2>

      <% if @task.comments.any? %>
        <div class="d-flex flex-column gap-3 mb-3">
          <% @task.comments.each do |comment| %>
            <%= render "comments/comment", comment: comment %>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted small mb-3">No comments yet. Start the discussion below.</p>
      <% end %>

      <%= render "comments/form", task: @task, comment: @comment %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card p-4 mb-3">
      <h2 class="h6 section-title">Details</h2>
      <dl class="row mb-0 small">
        <dt class="col-5 text-muted fw-normal">Status</dt>
        <dd class="col-7 mb-2"><%= status_badge(@task.status) %></dd>

        <dt class="col-5 text-muted fw-normal">Assignee</dt>
        <dd class="col-7 mb-2">
          <% if @task.assignee %>
            <span class="user-chip" style="background:#fff;border-color:#dfe1e6;">
              <span class="avatar"><%= @task.assignee.email.first %></span>
              <span><%= @task.assignee.email %></span>
            </span>
          <% else %>
            <span class="text-muted">Unassigned</span>
          <% end %>
        </dd>

        <dt class="col-5 text-muted fw-normal">Reporter</dt>
        <dd class="col-7 mb-2"><%= @task.reporter&.email || "—" %></dd>

        <dt class="col-5 text-muted fw-normal">Project</dt>
        <dd class="col-7 mb-2">
          <%= link_to @task.project.name, project_path(@task.project) %>
        </dd>

        <dt class="col-5 text-muted fw-normal">Created</dt>
        <dd class="col-7 mb-2"><%= @task.created_at.strftime("%b %-d, %Y") %></dd>

        <dt class="col-5 text-muted fw-normal">Last updated</dt>
        <dd class="col-7 mb-0"><%= time_ago_in_words(@task.updated_at) %> ago</dd>
      </dl>
    </div>

    <%= link_to "Back to project", project_path(@task.project), class: "btn btn-subtle btn-sm" %>
  </div>
</div>
