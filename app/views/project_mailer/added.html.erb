<p style="margin:0 0 12px;font-size:16px;font-weight:600;">
  You're now part of <%= @project.name %>
</p>
<p style="margin:0 0 16px;color:#42526e;">
  <%= @actor&.email || "Someone" %> added you to the project
  <strong><%= @project.name %></strong>. You can now view its tasks, post
  comments, upload attachments, and have tasks assigned to you.
</p>

<table cellpadding="0" cellspacing="0" style="width:100%;background:#f4f8ff;border:1px solid #deebff;border-radius:6px;padding:14px 16px;margin-bottom:20px;">
  <tr>
    <td>
      <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:#0747a6;font-weight:700;margin-bottom:6px;">
        Project
      </div>
      <div style="font-size:15px;font-weight:600;color:#172b4d;margin-bottom:6px;">
        <%= @project.name %>
      </div>
      <% if @project.description.present? %>
        <div style="font-size:13px;color:#42526e;white-space:pre-line;">
          <%= truncate(@project.description, length: 280) %>
        </div>
      <% end %>
    </td>
  </tr>
</table>

<p style="margin:0;">
  <a href="<%= @project_url %>"
     style="display:inline-block;background:#0052cc;color:#fff;text-decoration:none;padding:10px 18px;border-radius:4px;font-weight:600;">
    Open project
  </a>
</p>
